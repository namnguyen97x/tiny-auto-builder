{
  "name": "Gaming",
  "description": "Optimized for maximum gaming performance and low latency",
  "debloat": {
    "removeAppx": true,
    "removeCapabilities": true,
    "removeWindowsPackages": true,
    "removeOneDrive": true,
    "removeAI": true,
    "removeEdge": true,
    "removeStore": false,
    "removeDefender": false
  },
  "privacy": {
    "disableTelemetry": true,
    "disableAds": true,
    "disableSponsoredApps": true,
    "disableThirdPartyTelemetry": true
  },
  "performance": {
    "enableUltimatePerformance": true,
    "tuneMouseLatency": true,
    "tuneDefenderCpuLimit": true
  },
  "installApps": [
    "7zip.7zip",
    "Valve.Steam",
    "Discord.Discord"
  ]
}
